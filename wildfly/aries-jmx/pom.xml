<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jboss.osgi.wildfly</groupId>
        <artifactId>jbosgi-wildfly</artifactId>
        <version>2.14.0.Final</version>
    </parent>

    <name>JBossOSGi WildFly: Apache Aries JMX</name>
    <description>
        The Apache Aries JMX bundle of the server: org.apache.aries.jmx with the patched classes in src/main/java
        (BundleStateMBean ActivationPolicyUsed item, BundleWiringStateMBean revisions without a wiring)
    </description>

    <artifactId>jbosgi-aries-jmx</artifactId>

    <properties>
        <aries.jmx.bundle.version>${version.apache.aries.jmx}.jbosgi-1</aries.jmx.bundle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.aries.jmx</groupId>
            <artifactId>org.apache.aries.jmx</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The content of the original bundle without the patched classes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-aries-jmx</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.aries.jmx</groupId>
                                    <artifactId>org.apache.aries.jmx</artifactId>
                                    <version>${version.apache.aries.jmx}</version>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <excludes>org/apache/aries/jmx/codec/BundleData.class,org/apache/aries/jmx/codec/BundleData$Header.class,org/apache/aries/jmx/framework/wiring/BundleWiringState.class</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!-- The original manifest on its own, unpacked on every build: the manifest of the bundle is made from it -->
                    <execution>
                        <id>unpack-aries-jmx-manifest</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.aries.jmx</groupId>
                                    <artifactId>org.apache.aries.jmx</artifactId>
                                    <version>${version.apache.aries.jmx}</version>
                                    <outputDirectory>${project.build.directory}/aries-jmx-manifest</outputDirectory>
                                    <includes>META-INF/MANIFEST.MF</includes>
                                    <overWrite>true</overWrite>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The manifest of the original bundle, with a version that tells the patched bundle apart. It is copied from
                 the original manifest first, so that a build without clean does not change the version again -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-version</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/aries-jmx-manifest/META-INF/MANIFEST.MF" tofile="${project.build.outputDirectory}/META-INF/MANIFEST.MF" overwrite="true" />
                                <replace file="${project.build.outputDirectory}/META-INF/MANIFEST.MF" token="Bundle-Version: ${version.apache.aries.jmx}" value="Bundle-Version: ${aries.jmx.bundle.version}" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
